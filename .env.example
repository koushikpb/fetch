# Copy to .env and fill in real values. Never commit .env — .gitignore already excludes it.
# lib/config.ts is the only module that reads these; every variable here is validated at
# boot (SPEC F-03) and boot fails loudly, listing every problem at once, if a required one
# is missing or malformed.

# Required. Postgres connection string. Must start with postgres:// or postgresql://.
DATABASE_URL=postgresql://fetch:changeme@localhost:5432/fetch_dev

# Required. Anthropic API key used for Haiku 4.5 extraction and Sonnet 5 synthesis
# (lib/llm.ts, F-05). Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-OWN-KEY

# Optional — Reddit adapter (sources/reddit, I-04). REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET,
# and REDDIT_USER_AGENT must be set together or all left unset; a partial set fails at boot
# rather than at runtime.
REDDIT_CLIENT_ID=your-reddit-app-client-id
REDDIT_CLIENT_SECRET=your-reddit-app-client-secret
# Reddit's API rules require a descriptive user agent identifying the app and a contact —
# see https://github.com/reddit-archive/reddit/wiki/API#rules.
REDDIT_USER_AGENT=fetch-app/0.1 (by /u/your-reddit-username)

# Optional — which subreddits ingestion sweeps, comma-separated. Only meaningful alongside
# the three credentials above: without them Reddit is skipped entirely, so this is ignored
# and boot warns about it (it does not fail — Hacker News and App Store keep ingesting).
# Unset leaves the Reddit adapter's own default (no subreddits) in force.
REDDIT_SUBREDDITS=selfhosted,smallbusiness

# Optional — how many comments a post needs before ingestion spends a request expanding its
# thread. This is the knob that decides a listing page's request cost against Reddit's 100
# QPM ceiling. Unset leaves the adapter's own default (5) in force.
REDDIT_MIN_COMMENTS_TO_EXPAND=5

# Optional — Hacker News search terms, comma-separated (sources/hackernews, I-02). Each is
# issued independently and the results merged. Unset leaves the adapter's default, which is
# a single empty query matching everything.
HN_QUERIES=postgres,pgvector

# Optional — App Store numeric app IDs and ISO 3166-1 alpha-2 storefront codes, each
# comma-separated (sources/appstore, I-03). A run crosses every app ID by every territory.
# Unset leaves the adapter's own defaults.
APPSTORE_APP_IDS=284910350,570060128
APPSTORE_TERRITORIES=us,gb

# --- Scheduling (jobs/, I-06) -------------------------------------------------------------
# Read by `pnpm worker`, the long-running scheduler. Changing anything in this block takes
# effect on the next worker restart — the worker re-applies every queue setting and every
# schedule on boot, including removing a schedule for a source that has been switched off.
# `pnpm ingest` is unaffected: it runs every source once and exits, no schedule involved.

# Optional — when each source runs, as a five-field cron expression (minute hour day-of-month
# month day-of-week), or the literal `off` to stop scheduling that source at all. Unset is not
# the same as `off`: unset takes the default shown here.
#
# The defaults differ per source on purpose. Hacker News is free and unmetered and turns over
# continuously, so it runs often; the App Store's RSS review feeds are CDN-cached and refresh
# far more slowly than hourly, so polling harder returns the same page twice; Reddit is capped
# at 100 QPM and is designed for personal-use limits until a license exists. The minute offsets
# are deliberately distinct so the three sources do not all fire on the same tick.
#
# Note that ingesting more often does not ingest more: each source resumes from a persisted
# cursor, so cadence changes how the same volume is divided into runs, not how much is fetched.
#
# A tick that arrives while the previous run of the same source is still pending is dropped,
# not queued behind it — nothing is lost, since the next run resumes from the same cursor —
# and each drop is logged at warn level naming the source, so a source that is chronically
# running slower than its cadence is visible rather than quietly halving its own frequency.
INGEST_SCHEDULE_HACKERNEWS=*/15 * * * *
INGEST_SCHEDULE_APPSTORE=17 * * * *
INGEST_SCHEDULE_REDDIT=37 * * * *

# Optional — IANA time zone the cron expressions above are interpreted in. Defaults to UTC
# (CLAUDE.md: timestamps are UTC, always).
INGEST_SCHEDULE_TIMEZONE=UTC

# Optional — how many times a failed run is retried before the scheduler gives up on it.
# 0 means "attempt once, never retry". On giving up, the job is moved to the
# `ingest.dead-letter` queue and logged at error level; the next scheduled run still happens
# normally, resuming from the cursor. Defaults to 3.
INGEST_RETRY_LIMIT=3

# Optional — delay before the first retry, in seconds. Retries back off exponentially from
# this value (with jitter) up to INGEST_RETRY_DELAY_MAX_SECONDS, which must not be smaller
# than it — a smaller maximum would clamp every retry to one fixed delay, which is not
# backoff, and boot rejects that. Default 60 and 900; the maximum is deliberately below the
# shortest default cadence so a retry chain cannot still be waiting when the next tick lands.
INGEST_RETRY_DELAY_SECONDS=60
INGEST_RETRY_DELAY_MAX_SECONDS=900

# Optional — how long a single run may hold its source's queue slot, in seconds. Must be
# between 60 and 86399 (pg-boss refuses 24 hours or more); boot rejects anything outside that
# range by name rather than letting the assertion surface from inside pg-boss.
#
# This is the one setting that can defeat the per-source lock, and it is worth understanding
# before changing it. Expiry is not a passive timeout: pg-boss races the handler against it
# *inside the worker process* and, when the deadline wins, fails the job and lets it retry —
# but it cannot actually stop the run, which keeps going. Set this below a source's real run
# duration and you do not abort anything, you multiply it: measured at `INGEST_RETRY_LIMIT + 1`
# concurrent runs of one source, ending in a "gave up" error for a run that was still going.
#
# So raise it, never lower it, if a source legitimately takes longer than this. The default is
# far above any observed run. A run that does overrun is logged at error level naming this
# variable, so the condition is loud rather than silent, but the overlap itself is not
# prevented. Defaults to 3600.
INGEST_JOB_EXPIRY_SECONDS=3600

# Optional. Monthly spend ceiling in USD enforced by the budget guard (lib/budget.ts, F-05).
# Defaults to 70 — CLAUDE.md's cost envelope ("under $70/month").
BUDGET_CEILING_USD=70

# Optional. One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=info

# Optional. One of: development, test, production. Defaults to development.
NODE_ENV=development
